<?xml version="1.0" encoding="utf-8"?>
<!-- The brew timer widget's progress bar: a rounded track with the brew so far in the accent colour. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><corners android:radius="3dp" /><solid android:color="@color/widget_row" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><corners android:radius="3dp" /><solid android:color="@color/widget_btn" /></shape></clip>
    </item>
</layer-list>
