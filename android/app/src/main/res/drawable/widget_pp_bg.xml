<?xml version="1.0" encoding="utf-8"?>
<!-- The passport's cover: dark leather with a stitched gold edge, the same in light and dark. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="300" android:startColor="#3A2216" android:endColor="#1B100A" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#47E2B866" android:dashWidth="4dp" android:dashGap="3dp" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
