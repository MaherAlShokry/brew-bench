<?xml version="1.0" encoding="utf-8"?>
<!-- The Coffee passport widget: the passport's leather cover (see PassportWidget). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pp_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_pp_bg"
    android:orientation="vertical"
    android:padding="16dp">
    <TextView android:id="@+id/pp_kicker" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="Coffee passport" android:textAllCaps="true" android:letterSpacing="0.14" android:textColor="#E2B866" android:textSize="11sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="bottom" android:orientation="horizontal">
            <TextView android:id="@+id/pp_n" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#F2D59A" android:textSize="40sp" android:textStyle="bold" />
            <TextView android:id="@+id/pp_of" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_marginBottom="4dp" android:ellipsize="end" android:maxLines="2" android:textColor="#BFFFF8EE" android:textSize="14sp" />
        </LinearLayout>
        <FrameLayout android:layout_width="64dp" android:layout_height="64dp" android:layout_marginStart="10dp">
            <ImageView android:id="@+id/pp_ring" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" />
            <TextView android:id="@+id/pp_pct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:textColor="#FFF8EE" android:textSize="14sp" android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>
    <ImageView android:id="@+id/pp_bars" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp" android:adjustViewBounds="true" android:importantForAccessibility="no" android:scaleType="fitStart" />
    <TextView android:id="@+id/pp_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:ellipsize="end" android:maxLines="1" android:textColor="#E2B866" android:textSize="12sp" android:textStyle="bold" />
</LinearLayout>
