<?xml version="1.0" encoding="utf-8"?>
<!-- The Coffee passport widget, drawn whole in the shelf card's look (WidgetArt.passport). Tapping opens the passport. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pp_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView android:id="@+id/pp_art" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="Coffee passport" />
</FrameLayout>
