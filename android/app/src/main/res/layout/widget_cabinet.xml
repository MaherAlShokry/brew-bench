<?xml version="1.0" encoding="utf-8"?>
<!-- Your shelf, drawn like the shelf share card (ShelfArt.shelf) to the widget's size. Over the picture, tap areas in the
     same places as what's drawn: a spacer as tall as the heading (one of three, for the heading's three sizes), then the
     panel's rows sharing its height, each opening its coffee, with its round log button's 44dp at the end. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/c_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView android:id="@+id/c_art" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:contentDescription="Your shelf" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <FrameLayout android:id="@+id/c_sp0" android:layout_width="match_parent" android:layout_height="44dp" />
        <FrameLayout android:id="@+id/c_sp1" android:layout_width="match_parent" android:layout_height="78dp" android:visibility="gone" />
        <FrameLayout android:id="@+id/c_sp2" android:layout_width="match_parent" android:layout_height="112dp" android:visibility="gone" />
        <LinearLayout android:id="@+id/c_rows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="16dp" android:orientation="vertical">
        <LinearLayout android:id="@+id/c_row0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:visibility="gone">
            <FrameLayout android:id="@+id/c_h0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/c_l0" android:layout_width="44dp" android:layout_height="match_parent" android:contentDescription="Log a brew with this coffee" />
        </LinearLayout>
        <LinearLayout android:id="@+id/c_row1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:visibility="gone">
            <FrameLayout android:id="@+id/c_h1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/c_l1" android:layout_width="44dp" android:layout_height="match_parent" android:contentDescription="Log a brew with this coffee" />
        </LinearLayout>
        <LinearLayout android:id="@+id/c_row2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:visibility="gone">
            <FrameLayout android:id="@+id/c_h2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/c_l2" android:layout_width="44dp" android:layout_height="match_parent" android:contentDescription="Log a brew with this coffee" />
        </LinearLayout>
        <LinearLayout android:id="@+id/c_row3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:visibility="gone">
            <FrameLayout android:id="@+id/c_h3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/c_l3" android:layout_width="44dp" android:layout_height="match_parent" android:contentDescription="Log a brew with this coffee" />
        </LinearLayout>
        <LinearLayout android:id="@+id/c_row4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:visibility="gone">
            <FrameLayout android:id="@+id/c_h4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/c_l4" android:layout_width="44dp" android:layout_height="match_parent" android:contentDescription="Log a brew with this coffee" />
        </LinearLayout>
        <LinearLayout android:id="@+id/c_row5" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:visibility="gone">
            <FrameLayout android:id="@+id/c_h5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/c_l5" android:layout_width="44dp" android:layout_height="match_parent" android:contentDescription="Log a brew with this coffee" />
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
