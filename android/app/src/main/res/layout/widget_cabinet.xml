<?xml version="1.0" encoding="utf-8"?>
<!-- Your cabinet: a heading, then a compact row per coffee on the shelf (its photo or flag, its name, and a dot in its
     freshness colour with the countdown and cups left). Rows keep their size; what doesn't fit is counted in the heading. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/c_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="6dp" android:importantForAccessibility="no" android:src="@drawable/widget_bean_ic" />
        <TextView android:id="@+id/c_kicker" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="Your cabinet" android:textAllCaps="true" android:letterSpacing="0.08" android:textColor="@color/widget_muted" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/c_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="11sp" />
    </LinearLayout>
    <TextView android:id="@+id/c_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:text="@string/widget_cabinet_empty" android:textColor="@color/widget_ink" android:textSize="15sp" android:visibility="gone" />
    <LinearLayout android:id="@+id/c_rows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:id="@+id/c_row0" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="6dp" android:background="@drawable/widget_tile" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="12dp" android:visibility="gone">
            <FrameLayout android:layout_width="38dp" android:layout_height="38dp" android:layout_marginEnd="10dp" android:background="@drawable/widget_pic">
                <TextView android:id="@+id/c_g0" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textSize="19sp" />
                <ImageView android:id="@+id/c_p0" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="centerCrop" android:visibility="gone" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/c_t0" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_ink" android:textSize="14sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:id="@+id/c_d0" android:layout_width="7dp" android:layout_height="7dp" android:layout_marginEnd="6dp" android:importantForAccessibility="no" android:src="@drawable/wdot_peak" />
                    <TextView android:id="@+id/c_f0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_muted" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/c_row1" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="6dp" android:background="@drawable/widget_tile" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="12dp" android:visibility="gone">
            <FrameLayout android:layout_width="38dp" android:layout_height="38dp" android:layout_marginEnd="10dp" android:background="@drawable/widget_pic">
                <TextView android:id="@+id/c_g1" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textSize="19sp" />
                <ImageView android:id="@+id/c_p1" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="centerCrop" android:visibility="gone" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/c_t1" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_ink" android:textSize="14sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:id="@+id/c_d1" android:layout_width="7dp" android:layout_height="7dp" android:layout_marginEnd="6dp" android:importantForAccessibility="no" android:src="@drawable/wdot_peak" />
                    <TextView android:id="@+id/c_f1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_muted" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/c_row2" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="6dp" android:background="@drawable/widget_tile" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="12dp" android:visibility="gone">
            <FrameLayout android:layout_width="38dp" android:layout_height="38dp" android:layout_marginEnd="10dp" android:background="@drawable/widget_pic">
                <TextView android:id="@+id/c_g2" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textSize="19sp" />
                <ImageView android:id="@+id/c_p2" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="centerCrop" android:visibility="gone" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/c_t2" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_ink" android:textSize="14sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:id="@+id/c_d2" android:layout_width="7dp" android:layout_height="7dp" android:layout_marginEnd="6dp" android:importantForAccessibility="no" android:src="@drawable/wdot_peak" />
                    <TextView android:id="@+id/c_f2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_muted" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/c_row3" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="6dp" android:background="@drawable/widget_tile" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="12dp" android:visibility="gone">
            <FrameLayout android:layout_width="38dp" android:layout_height="38dp" android:layout_marginEnd="10dp" android:background="@drawable/widget_pic">
                <TextView android:id="@+id/c_g3" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textSize="19sp" />
                <ImageView android:id="@+id/c_p3" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="centerCrop" android:visibility="gone" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/c_t3" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_ink" android:textSize="14sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:id="@+id/c_d3" android:layout_width="7dp" android:layout_height="7dp" android:layout_marginEnd="6dp" android:importantForAccessibility="no" android:src="@drawable/wdot_peak" />
                    <TextView android:id="@+id/c_f3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_muted" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/c_row4" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="6dp" android:background="@drawable/widget_tile" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="12dp" android:visibility="gone">
            <FrameLayout android:layout_width="38dp" android:layout_height="38dp" android:layout_marginEnd="10dp" android:background="@drawable/widget_pic">
                <TextView android:id="@+id/c_g4" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textSize="19sp" />
                <ImageView android:id="@+id/c_p4" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="centerCrop" android:visibility="gone" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/c_t4" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_ink" android:textSize="14sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:id="@+id/c_d4" android:layout_width="7dp" android:layout_height="7dp" android:layout_marginEnd="6dp" android:importantForAccessibility="no" android:src="@drawable/wdot_peak" />
                    <TextView android:id="@+id/c_f4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_muted" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/c_row5" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="6dp" android:background="@drawable/widget_tile" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="12dp" android:visibility="gone">
            <FrameLayout android:layout_width="38dp" android:layout_height="38dp" android:layout_marginEnd="10dp" android:background="@drawable/widget_pic">
                <TextView android:id="@+id/c_g5" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textSize="19sp" />
                <ImageView android:id="@+id/c_p5" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="centerCrop" android:visibility="gone" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/c_t5" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_ink" android:textSize="14sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:id="@+id/c_d5" android:layout_width="7dp" android:layout_height="7dp" android:layout_marginEnd="6dp" android:importantForAccessibility="no" android:src="@drawable/wdot_peak" />
                    <TextView android:id="@+id/c_f5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_muted" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/c_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:textColor="@color/widget_accent" android:textSize="12sp" android:textStyle="bold" android:visibility="gone" />
</LinearLayout>
