<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="6dp" android:importantForAccessibility="no" android:src="@drawable/widget_bean_ic" />
        <TextView android:id="@+id/w_kicker" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:text="Drinking now" android:textAllCaps="true" android:letterSpacing="0.08" android:textColor="@color/widget_muted" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/wchip_peak" android:paddingStart="10dp" android:paddingTop="3dp" android:paddingEnd="10dp" android:paddingBottom="3dp" android:textColor="@color/widget_peak" android:textSize="11sp" android:textStyle="bold" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <FrameLayout android:id="@+id/w_pic" android:layout_width="64dp" android:layout_height="64dp" android:layout_marginEnd="14dp" android:background="@drawable/widget_tile">
            <TextView android:id="@+id/w_flag" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textSize="30sp" />
            <ImageView android:id="@+id/w_photo" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="centerCrop" android:visibility="gone" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textColor="@color/widget_ink" android:textSize="19sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_muted" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_foot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="12dp" android:orientation="vertical">
        <ProgressBar android:id="@+id/w_pb0" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="100" android:progressDrawable="@drawable/wpb_rest" android:visibility="gone" />
        <ProgressBar android:id="@+id/w_pb1" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="100" android:progressDrawable="@drawable/wpb_peak" android:visibility="gone" />
        <ProgressBar android:id="@+id/w_pb2" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="100" android:progressDrawable="@drawable/wpb_good" android:visibility="gone" />
        <ProgressBar android:id="@+id/w_pb3" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="100" android:progressDrawable="@drawable/wpb_fade" android:visibility="gone" />
            <TextView android:id="@+id/w_fresh" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_muted" android:textSize="12sp" />
        </LinearLayout>
        <TextView android:id="@+id/w_log" android:layout_width="wrap_content" android:layout_height="40dp" android:background="@drawable/widget_btn" android:gravity="center" android:paddingStart="18dp" android:paddingEnd="18dp" android:text="Log brew" android:textColor="@color/widget_btn_ink" android:textSize="14sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
