<?xml version="1.0" encoding="utf-8"?>
<!-- Drinking now, drawn like the shelf share card (ShelfArt.drinking) to the widget's size: the picture fills the widget
     and opens the coffee; the round log button drawn at the top right has its tap area here (44dp, centred on it). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView android:id="@+id/w_art" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:contentDescription="Drinking now" />
    <FrameLayout android:id="@+id/w_log" android:layout_width="44dp" android:layout_height="44dp"
        android:layout_gravity="top|end" android:layout_marginTop="2dp" android:layout_marginEnd="9dp"
        android:contentDescription="Log a brew with this coffee" />
</FrameLayout>
