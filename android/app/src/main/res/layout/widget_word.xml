<?xml version="1.0" encoding="utf-8"?>
<!-- "Coffee word of the day" (WordWidget). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wd_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_bean_ic" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_word_name"
            android:textAllCaps="true"
            android:letterSpacing="0.06"
            android:textColor="@color/widget_muted"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
    <TextView
        android:id="@+id/wd_word"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_ink"
        android:textSize="20sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/wd_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="4"
        android:textColor="@color/widget_muted"
        android:textSize="13sp" />
</LinearLayout>
