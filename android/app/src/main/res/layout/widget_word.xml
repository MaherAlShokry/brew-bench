<?xml version="1.0" encoding="utf-8"?>
<!-- Coffee word of the day, drawn whole in the shelf card's look (WidgetArt.word): the heading with today's date, the
     word, a rule in its part of coffee's colour, the meaning, and its topic and Read more. Tapping opens the word. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wd_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView android:id="@+id/wd_art" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="Coffee word of the day" />
</FrameLayout>
