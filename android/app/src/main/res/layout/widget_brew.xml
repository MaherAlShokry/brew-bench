<?xml version="1.0" encoding="utf-8"?>
<!-- Quick brew, drawn whole in the shelf card's look (WidgetArt.quick). Over the picture: the brew's clock (a live
     view that ticks by itself, placed where the picture leaves room for it) and tap areas on the drawn buttons. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/q_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView android:id="@+id/q_art" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:contentDescription="Quick brew" />
    <FrameLayout android:id="@+id/q_clkbox" android:layout_width="match_parent" android:layout_height="match_parent">
        <Chronometer android:id="@+id/q_chrono" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:textStyle="bold" android:fontFeatureSettings="tnum" android:visibility="gone" />
    </FrameLayout>
    <LinearLayout android:id="@+id/q_ctl" android:layout_width="match_parent" android:layout_height="40dp" android:layout_gravity="bottom" android:layout_margin="16dp" android:orientation="horizontal" android:visibility="gone">
        <FrameLayout android:id="@+id/q_pp" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="8dp" android:contentDescription="Pause or resume" />
        <FrameLayout android:id="@+id/q_nx" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:contentDescription="Next step" />
    </LinearLayout>
    <FrameLayout android:id="@+id/q_go" android:layout_width="match_parent" android:layout_height="40dp" android:layout_gravity="bottom" android:layout_margin="16dp" android:visibility="gone" />
</FrameLayout>
