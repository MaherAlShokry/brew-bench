<?xml version="1.0" encoding="utf-8"?>
<!-- "Quick brew" (QuickBrewWidget): your go-to recipe and Start timer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/q_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_bean_ic" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_brew_name"
                android:textAllCaps="true"
                android:letterSpacing="0.06"
                android:textColor="@color/widget_muted"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView
            android:id="@+id/q_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/widget_ink"
            android:textSize="17sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/q_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/widget_accent"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/q_go"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:background="@drawable/widget_btn"
        android:gravity="center"
        android:minHeight="48dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/widget_btn_ink"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
